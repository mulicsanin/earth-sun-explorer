---
import EarthlightApp from '../components/EarthlightApp.svelte';
import '../styles/global.css';
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta
      name="description"
      content="Earthlight Observatory is a cinematic 3D Earth page for exploring the current Sun position, daylight line, and observer location."
    />
    <meta name="theme-color" content="#070914" />
    <title>Earthlight Observatory</title>
  </head>
  <body>
    <EarthlightApp client:only="svelte" />
  </body>
</html>
